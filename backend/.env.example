# =========================================================
# DATABASE
# =========================================================

# Production / Neon
# Không commit connection string thật lên GitHub.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local PostgreSQL fallback
# Chỉ được dùng khi DATABASE_URL, NEON_DATABASE_URL và POSTGRES_URL không có giá trị.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vinh_khanh_narration_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSLMODE=disable
DB_TRUST_SERVER_CERTIFICATE=false


# =========================================================
# ASP.NET CORE
# =========================================================

ASPNETCORE_ENVIRONMENT=Development
# Chỉ dùng trên cùng máy:
ASPNETCORE_URLS=http://localhost:5151

# Khi điện thoại cần gọi backend qua Wi-Fi, có thể dùng:
# ASPNETCORE_URLS=http://0.0.0.0:5151

# Thêm URL frontend LAN nếu quét QR từ điện thoại, phân tách nhiều origin bằng dấu phẩy.
# Ví dụ: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.20:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173


# =========================================================
# JWT
# =========================================================

Jwt__SecretKey=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_FOR_DEVELOPMENT
Jwt__Issuer=VinhKhanhNarration
Jwt__Audience=VinhKhanhNarrationClient


# =========================================================
# TRANSLATION
# =========================================================

# Mặc định dùng GoogleFree để demo 5 ngôn ngữ, không cần API key.
# Có thể đổi sang AzureTranslator nếu sau này có tài khoản Azure.
Translation__Provider=GoogleFree

Translator__Endpoint=https://api.cognitive.microsofttranslator.com
Translator__Key=
Translator__Region=


# =========================================================
# TEXT-TO-SPEECH
# =========================================================

# EdgeTTS gọi Python local và tạo MP3 cho vi/en/ja/ko/zh.
# Chạy backend/tools/setup_edge_tts.ps1 trước khi khởi động backend.
Speech__Provider=EdgeTTS
EdgeTts__PythonPath=.venv-tts/Scripts/python.exe
EdgeTts__ScriptPath=tools/edge_tts_synthesize.py
EdgeTts__Rate=+0%
EdgeTts__Volume=+0%
EdgeTts__Pitch=+0Hz
EdgeTts__TimeoutSeconds=120

# Chỉ dùng khi muốn quay lại Azure Speech.
Speech__Key=
Speech__Region=


# =========================================================
# AUDIO STORAGE
# =========================================================

# Local development keeps MP3 under backend/wwwroot/generated-audio.
# Render production must use R2 because the Render filesystem is ephemeral.
Storage__Provider=Local

# Set Storage__Provider=R2 on Render and provide all values below.
R2__AccountId=
R2__AccessKeyId=
R2__SecretAccessKey=
R2__BucketName=vinhkhanh-audio
# Optional. If blank, the backend builds this from R2__AccountId.
R2__Endpoint=
R2__Prefix=audio
R2__SignedUrlMinutes=5


# =========================================================
# PAYMENT
# =========================================================

# Mock dùng để demo đồ án, không giao dịch tiền thật.
Payment__Provider=Mock
# =========================================================
# GUEST ACCESS PASS (MOCK)
# =========================================================

GuestAccess__Price=50000
GuestAccess__DurationHours=24
GuestAccess__OrderExpiryMinutes=30

# =========================================================
# LIFECYCLE MAINTENANCE
# =========================================================

# Chu kỳ hết hạn payment, subscription, pass và dọn refresh token.
Lifecycle__IntervalMinutes=15

# Xóa geofence log cũ sau số ngày này.
Lifecycle__GeofenceRetentionDays=90

# Frontend URL vẫn được dùng để tạo đường dẫn mở trang đơn Mock.
# Ảnh QR thanh toán là một ảnh cố định dùng chung, không chứa orderCode và không nhận tiền thật.
FRONTEND_URL=http://localhost:5173

