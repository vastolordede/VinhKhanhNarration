# =========================================================
# DATABASE
# =========================================================

# Production / Neon
# Không commit connection string thật lên GitHub.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local PostgreSQL fallback
# Chỉ được dùng khi DATABASE_URL, NEON_DATABASE_URL và POSTGRES_URL không có giá trị.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vinh_khanh_narration_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSLMODE=disable
DB_TRUST_SERVER_CERTIFICATE=false


# =========================================================
# ASP.NET CORE
# =========================================================

ASPNETCORE_ENVIRONMENT=Development
# Chỉ dùng trên cùng máy:
ASPNETCORE_URLS=http://localhost:5151

# Khi điện thoại cần gọi backend qua Wi-Fi, có thể dùng:
# ASPNETCORE_URLS=http://0.0.0.0:5151

# Thêm URL frontend LAN nếu quét QR từ điện thoại, phân tách nhiều origin bằng dấu phẩy.
# Ví dụ: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.20:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173


# =========================================================
# JWT
# =========================================================

Jwt__SecretKey=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_FOR_DEVELOPMENT
Jwt__Issuer=VinhKhanhNarration
Jwt__Audience=VinhKhanhNarrationClient


# =========================================================
# AZURE TRANSLATOR
# =========================================================

Translator__Endpoint=https://api.cognitive.microsofttranslator.com
Translator__Key=
Translator__Region=


# =========================================================
# AZURE SPEECH / TEXT-TO-SPEECH
# =========================================================

Speech__Key=
Speech__Region=


# =========================================================
# AUDIO STORAGE
# =========================================================

# Audio local được phát qua endpoint có kiểm tra quyền; không public trực tiếp wwwroot.


# =========================================================
# PAYMENT
# =========================================================

# Mock dùng để demo đồ án, không giao dịch tiền thật.
Payment__Provider=Mock
# =========================================================
# GUEST ACCESS PASS (MOCK)
# =========================================================

GuestAccess__Price=50000
GuestAccess__DurationHours=24
GuestAccess__OrderExpiryMinutes=30

# =========================================================
# LIFECYCLE MAINTENANCE
# =========================================================

# Chu kỳ hết hạn payment, subscription, pass và dọn refresh token.
Lifecycle__IntervalMinutes=15

# Xóa geofence log cũ sau số ngày này.
Lifecycle__GeofenceRetentionDays=90

# Frontend URL encoded inside the mock-payment QR.
# Khi quét QR bằng điện thoại trong cùng Wi-Fi, thay localhost bằng IP LAN của máy chạy frontend,
# ví dụ: FRONTEND_URL=http://192.168.1.20:5173
# Đây chỉ là URL nội bộ của ứng dụng, KHÔNG phải VietQR hoặc link cổng thanh toán thật.
FRONTEND_URL=http://localhost:5173
